        <mxCell id="2EAoy8cLZnvSIJRCehKP-1" value="&lt;div style=&quot;color: rgb(204, 204, 204); background-color: rgb(31, 31, 31); font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 14px; line-height: 19px; white-space: pre;&quot;&gt;&lt;div&gt;&amp;nbsp; {&lt;span style=&quot;color: rgb(181, 206, 168);&quot;&gt;0x3C&lt;/span&gt;, &lt;span style=&quot;color: rgb(181, 206, 168);&quot;&gt;0&lt;/span&gt;, &lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;&quot;SBR&quot;&lt;/span&gt;, &amp;nbsp; &amp;nbsp; &amp;nbsp;(&lt;span style=&quot;color: rgb(78, 201, 176);&quot;&gt;ProgAddr_t&lt;/span&gt;) &lt;span style=&quot;color: rgb(212, 212, 212);&quot;&gt;&amp;amp;&lt;/span&gt;&lt;span style=&quot;color: rgb(220, 220, 170);&quot;&gt;Cmd_Set_Burst_Time&lt;/span&gt;},&lt;span style=&quot;color: rgb(106, 153, 85);&quot;&gt; &amp;nbsp;// Set Burst time / phase angle&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; {&lt;span style=&quot;color: rgb(181, 206, 168);&quot;&gt;0x3D&lt;/span&gt;, &lt;span style=&quot;color: rgb(181, 206, 168);&quot;&gt;0&lt;/span&gt;, &lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;&quot;IBR&quot;&lt;/span&gt;, &amp;nbsp; &amp;nbsp; &amp;nbsp;(&lt;span style=&quot;color: rgb(78, 201, 176);&quot;&gt;ProgAddr_t&lt;/span&gt;) &lt;span style=&quot;color: rgb(212, 212, 212);&quot;&gt;&amp;amp;&lt;/span&gt;&lt;span style=&quot;color: rgb(220, 220, 170);&quot;&gt;Cmd_Inc_Burst_Time&lt;/span&gt;},&lt;span style=&quot;color: rgb(106, 153, 85);&quot;&gt; &amp;nbsp;// Inc/Dec Burst time / phase angle&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(106, 153, 85), rgb(91, 131, 73)); background-color: light-dark(rgb(31, 31, 31), rgb(210, 210, 210));&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;background-color: light-dark(rgb(31, 31, 31), rgb(210, 210, 210)); color: rgb(181, 206, 168);&quot;&gt;0x71&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(106, 153, 85), rgb(91, 131, 73)); background-color: light-dark(rgb(31, 31, 31), rgb(210, 210, 210));&quot;&gt;, &lt;/span&gt;&lt;span style=&quot;background-color: light-dark(rgb(31, 31, 31), rgb(210, 210, 210)); color: rgb(181, 206, 168);&quot;&gt;0&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(106, 153, 85), rgb(91, 131, 73)); background-color: light-dark(rgb(31, 31, 31), rgb(210, 210, 210));&quot;&gt;, &lt;/span&gt;&lt;span style=&quot;background-color: light-dark(rgb(31, 31, 31), rgb(210, 210, 210)); color: rgb(206, 145, 120);&quot;&gt;&quot;PWR&quot;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(106, 153, 85), rgb(91, 131, 73)); background-color: light-dark(rgb(31, 31, 31), rgb(210, 210, 210));&quot;&gt;, &amp;nbsp; &amp;nbsp; &amp;nbsp;(&lt;/span&gt;&lt;span style=&quot;background-color: light-dark(rgb(31, 31, 31), rgb(210, 210, 210)); color: rgb(78, 201, 176);&quot;&gt;ProgAddr_t&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(106, 153, 85), rgb(91, 131, 73)); background-color: light-dark(rgb(31, 31, 31), rgb(210, 210, 210));&quot;&gt;) &lt;/span&gt;&lt;span style=&quot;background-color: light-dark(rgb(31, 31, 31), rgb(210, 210, 210)); color: rgb(212, 212, 212);&quot;&gt;&amp;amp;&lt;/span&gt;&lt;span style=&quot;background-color: light-dark(rgb(31, 31, 31), rgb(210, 210, 210)); color: rgb(220, 220, 170);&quot;&gt;GetActualPower&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(106, 153, 85), rgb(91, 131, 73)); background-color: light-dark(rgb(31, 31, 31), rgb(210, 210, 210));&quot;&gt;},&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(106, 153, 85), rgb(91, 131, 73)); background-color: light-dark(rgb(31, 31, 31), rgb(210, 210, 210));&quot;&gt; &amp;nbsp; &amp;nbsp; &amp;nbsp;// Get Transmitted Power&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;&lt;div&gt;&amp;nbsp; {&lt;span style=&quot;color: #b5cea8;&quot;&gt;0x37&lt;/span&gt;, &lt;span style=&quot;color: #b5cea8;&quot;&gt;0&lt;/span&gt;, &lt;span style=&quot;color: #ce9178;&quot;&gt;&quot;SPW&quot;&lt;/span&gt;, &amp;nbsp; &amp;nbsp; &amp;nbsp;(&lt;span style=&quot;color: #4ec9b0;&quot;&gt;ProgAddr_t&lt;/span&gt;) &lt;span style=&quot;color: #d4d4d4;&quot;&gt;&amp;amp;&lt;/span&gt;&lt;span style=&quot;color: #dcdcaa;&quot;&gt;Set_requested_power&lt;/span&gt;},&lt;span style=&quot;color: #6a9955;&quot;&gt; // Set Requested Power&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1">
