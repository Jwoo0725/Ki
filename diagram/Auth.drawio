        <mxCell id="y8at5WXoqM1N2DBuPDtX-15" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" vertex="1" parent="1">
          <mxGeometry x="32" y="2530" width="550.93" height="260" as="geometry" />
        </mxCell>
        <mxCell id="y8at5WXoqM1N2DBuPDtX-16" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" vertex="1" parent="1">
