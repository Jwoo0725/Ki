        <mxCell id="6pwwKCIL2NlfPv-GWAR0-15" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#FF0000;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="110" y="1770" as="sourcePoint" />
            <mxPoint x="370" y="1770" as="targetPoint" />
          </mxGeometry>
